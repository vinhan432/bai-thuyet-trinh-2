### 5B. Sourcing Protocol

1. Search Sketchfab with filters: `downloadable: true`, `license: CC0 or CC-BY`, `format: glTF/GLB`, `category: industrial/mechanical`.
2. Search Poly Pizza for stylized alternatives.
3. For simple objects (gears, hexagons, arrows, sheet metal), **generate procedurally** in Three.js.
4. Optimize **every** model: `npx @gltf-transform/cli optimize input.glb output.glb --compress draco --texture-compress ktx2`.
5. Verify: max 40K triangles, max 220 KB per file.
6. Document in `reports/3d-assets.md`: filename, source URL, license, author, triangle count, file size.

### 5C. Procedural Gear Generator

For the hero gear and variants, generate procedurally to guarantee quality:

```javascript
// js/utils/gear-generator.js
import * as THREE from 'three';

export function createGear({
  innerRadius = 0.6,
  outerRadius = 1.0,
  teeth = 20,
  toothDepth = 0.15,
  thickness = 0.3,
  color = 0xC9A96E,
  metalness = 0.8,
  roughness = 0.38,
} = {}) {
  const shape = new THREE.Shape();
  const steps = teeth * 4;

  for (let i = 0; i <= steps; i++) {
    const angle = (i / steps) * Math.PI * 2;
    const toothIndex = Math.floor((i / steps) * teeth * 4) % 4;
    let r;
    if (toothIndex < 2) r = outerRadius;
    else r = outerRadius - toothDepth;

    const x = Math.cos(angle) * r;
    const y = Math.sin(angle) * r;

    if (i === 0) shape.moveTo(x, y);
    else shape.lineTo(x, y);
  }

  // Center hole
  const hole = new THREE.Path();
  for (let i = 0; i <= 32; i++) {
    const angle = (i / 32) * Math.PI * 2;
    const x = Math.cos(angle) * innerRadius;
    const y = Math.sin(angle) * innerRadius;
    if (i === 0) hole.moveTo(x, y);
    else hole.lineTo(x, y);
  }
  shape.holes.push(hole);

  const extrudeSettings = {
    depth: thickness,
    bevelEnabled: true,
    bevelThickness: 0.02,
    bevelSize: 0.02,
    bevelSegments: 3,
  };

  const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);
  geometry.center();
  geometry.computeVertexNormals();

  const material = new THREE.MeshStandardMaterial({ color, metalness, roughness });
  const mesh = new THREE.Mesh(geometry, material);
  mesh.castShadow = true;
  mesh.receiveShadow = true;

  return mesh;
}

// Create meshing gear pair
export function createGearPair(config = {}) {
  const gear1 = createGear({ teeth: 20, outerRadius: 1.0, color: 0xC9A96E, ...config });
  const gear2 = createGear({ teeth: 14, outerRadius: 0.72, color: 0xD4C8B8, ...config });

  // Position gear2 so teeth mesh
  const distance = 1.0 + 0.72 - 0.08; // slight overlap for mesh illusion
  gear2.position.x = distance;

  const group = new THREE.Group();
  group.add(gear1, gear2);
  group.userData = { gear1, gear2, ratio: 20 / 14 };

  return group;
}
```

