```javascript
// js/utils/explode-controller.js
import * as THREE from 'three';

export class ExplodeController {
  constructor(group, partsConfig) {
    this.group = group;
    this.parts = [];
    this.exploded = false;
    this.progress = 0; // 0 = assembled, 1 = exploded
    this.labels = [];

    partsConfig.forEach(config => {
      const mesh = group.getObjectByName(config.meshName);
      if (!mesh) return;

      this.parts.push({
        mesh,
        originalPos: mesh.position.clone(),
        explodedPos: new THREE.Vector3(...config.explodedPosition),
        originalRot: mesh.rotation.clone(),
        explodedRot: config.explodedRotation
          ? new THREE.Euler(...config.explodedRotation)
          : mesh.rotation.clone(),
        label: config.label,         // Vietnamese name
        description: config.description, // Vietnamese short description
      });
    });
  }

  toggle() {
    this.exploded = !this.exploded;
  }

  update(delta) {
    const targetProgress = this.exploded ? 1 : 0;
    this.progress += (targetProgress - this.progress) * 0.06; // smooth lerp

    this.parts.forEach(part => {
      part.mesh.position.lerpVectors(part.originalPos, part.explodedPos, this.progress);

      // Interpolate rotation
      const q1 = new THREE.Quaternion().setFromEuler(part.originalRot);
      const q2 = new THREE.Quaternion().setFromEuler(part.explodedRot);
      const q = new THREE.Quaternion().slerpQuaternions(q1, q2, this.progress);
      part.mesh.quaternion.copy(q);
    });
  }

  getLabelsData() {
    if (this.progress < 0.5) return [];
    return this.parts.map(part => ({
      position: part.mesh.position.clone().add(new THREE.Vector3(0, 0.3, 0)),
      text: part.label,
      description: part.description,
      opacity: Math.max(0, (this.progress - 0.5) * 2),
    }));
  }
}

