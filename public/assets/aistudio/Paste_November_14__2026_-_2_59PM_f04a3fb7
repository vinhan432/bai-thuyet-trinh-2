// Stat counter with spring overshoot
function animateCounter(element, target, duration = 1200) {
  const start = performance.now();
  function tick(now) {
    const progress = Math.min((now - start) / duration, 1);
    // Spring overshoot curve
    const spring = 1 - Math.pow(2, -10 * progress) * Math.cos(progress * Math.PI * 3);
    const value = Math.round(target * Math.min(spring, 1.15)); // overshoot then settle
    element.textContent = value;
    if (progress < 1) requestAnimationFrame(tick);
    else element.textContent = target; // ensure final value
  }
  requestAnimationFrame(tick);
}

// Tooltip pop-in
function showTooltip(element) {
  element.style.transform = 'scale(0.85) translateY(8px)';
  element.style.opacity = '0';
  element.style.display = 'block';
  requestAnimationFrame(() => {
