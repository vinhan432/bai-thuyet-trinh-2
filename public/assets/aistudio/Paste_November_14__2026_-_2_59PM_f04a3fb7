# 6. CAMERA CHOREOGRAPHY & ANIMATION

### 6A. Camera Rig Module

```javascript
// js/utils/camera-rig.js
import * as THREE from 'three';

export class CameraRig {
  constructor(camera, config = {}) {
    this.camera = camera;
    this.target = new THREE.Vector3();
    this.currentPos = new THREE.Vector3().copy(camera.position);
    this.targetPos = new THREE.Vector3().copy(camera.position);
    this.lerpSpeed = config.lerpSpeed || 0.04;
    this.autoOrbit = config.autoOrbit || false;
    this.orbitSpeed = config.orbitSpeed || 0.15; // radians per second
    this.orbitRadius = config.orbitRadius || 6;
    this.orbitHeight = config.orbitHeight || 2;
    this.orbitCenter = new THREE.Vector3(...(config.orbitCenter || [0, 0, 0]));
    this.paused = false;
    this.pauseTimer = null;
  }

  setTarget(pos, lookAt, speed) {
    this.targetPos.set(...pos);
    if (lookAt) this.target.set(...lookAt);
    if (speed) this.lerpSpeed = speed;
  }

  dollyTo(pos, lookAt, duration = 1.5) {
    // Smooth cinematic dolly with easing
    const start = this.camera.position.clone();
    const end = new THREE.Vector3(...pos);
    const startLook = this.target.clone();
    const endLook = new THREE.Vector3(...(lookAt || [0, 0, 0]));
    let elapsed = 0;

    this._dollyAnim = { start, end, startLook, endLook, duration, elapsed };
  }

  pauseAutoOrbit(ms = 4000) {
    this.paused = true;
    clearTimeout(this.pauseTimer);
    this.pauseTimer = setTimeout(() => { this.paused = false; }, ms);
  }

  update(delta, elapsed) {
    // Dolly animation
    if (this._dollyAnim) {
      const d = this._dollyAnim;
      d.elapsed += delta;
      const t = Math.min(d.elapsed / d.duration, 1);
      const e = 1 - Math.pow(1 - t, 3); // ease-out cubic

      this.camera.position.lerpVectors(d.start, d.end, e);
      this.target.lerpVectors(d.startLook, d.endLook, e);
      this.camera.lookAt(this.target);

      if (t >= 1) this._dollyAnim = null;
      return;
    }

    // Auto orbit
    if (this.autoOrbit && !this.paused) {
      const angle = elapsed * this.orbitSpeed;
      this.camera.position.x = this.orbitCenter.x + Math.cos(angle) * this.orbitRadius;
      this.camera.position.z = this.orbitCenter.z + Math.sin(angle) * this.orbitRadius;
      this.camera.position.y = this.orbitCenter.y + this.orbitHeight;
    } else {
      // Lerp to target
      this.camera.position.lerp(this.targetPos, this.lerpSpeed);
    }

    this.camera.lookAt(this.target);
  }
}
```

