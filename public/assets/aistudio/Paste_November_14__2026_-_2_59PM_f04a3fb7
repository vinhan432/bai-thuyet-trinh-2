// js/three-manager.js
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
import { RGBELoader } from 'three/addons/loaders/RGBELoader.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';

export class ThreeManager {
  constructor() {
    this.scenes = new Map();
    this.activeScene = null;
    this.clock = new THREE.Clock();

    // Shared resources
    this.dracoLoader = new DRACOLoader();
    this.dracoLoader.setDecoderPath('https://cdn.jsdelivr.net/npm/three@0.168.0/examples/jsm/libs/draco/');
    this.gltfLoader = new GLTFLoader();
    this.gltfLoader.setDRACOLoader(this.dracoLoader);
    this.textureLoader = new THREE.TextureLoader();

    // Shared renderer
    this.renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    this.renderer.setSize(1920, 1080);
    this.renderer.outputColorSpace = THREE.SRGBColorSpace;
    this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure = 1.1;
    this.renderer.shadowMap.enabled = true;
    this.renderer.shadowMap.type = THREE.VSMShadowMap;

    // CSS2D renderer for Vietnamese labels
    this.labelRenderer = new CSS2DRenderer();
    this.labelRenderer.setSize(1920, 1080);
    this.labelRenderer.domElement.style.position = 'absolute';
    this.labelRenderer.domElement.style.top = '0';
    this.labelRenderer.domElement.style.pointerEvents = 'none';

    // Shared model cache
    this.modelCache = new Map();
  }

  async loadModel(path) {
    if (this.modelCache.has(path)) return this.modelCache.get(path).clone();
    const gltf = await this.gltfLoader.loadAsync(path);
    this.modelCache.set(path, gltf.scene);
    return gltf.scene.clone();
  }

  createScene(id, config) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      config.fov || 35,
      1920 / 1080,
      0.1,
      100
    );
    camera.position.set(...(config.cameraPos || [4, 2, 6]));

    // Attach warm lighting
    this.addWarmLighting(scene, config);

    // Store
    this.scenes.set(id, { scene, camera, config, objects: {}, mixers: [], update: null });
    return this.scenes.get(id);
  }

  addWarmLighting(scene, config = {}) {
    // Ambient — warm base
    const ambient = new THREE.AmbientLight(0xF5E8D8, config.ambientIntensity || 0.45);
    scene.add(ambient);

    // Key light — golden sun
    const key = new THREE.DirectionalLight(0xFFF0DC, config.keyIntensity || 1.8);
    key.position.set(5, 8, 4);
    key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048);
    key.shadow.camera.near = 0.5;
    key.shadow.camera.far = 20;
    key.shadow.camera.left = -5;
    key.shadow.camera.right = 5;
    key.shadow.camera.top = 5;
    key.shadow.camera.bottom = -5;
    key.shadow.bias = -0.0001;
    key.shadow.radius = 4;
    scene.add(key);

    // Fill — gentle cool
    const fill = new THREE.DirectionalLight(0xDDE8F0, config.fillIntensity || 0.5);
    fill.position.set(-4, 3, -3);
    scene.add(fill);

    // Rim — warm coral edge
    const rim = new THREE.DirectionalLight(0xE8775A, config.rimIntensity || 0.3);
    rim.position.set(0, -1, -4);
    scene.add(rim);

    // Ground plane for contact shadow
    const shadowGeo = new THREE.PlaneGeometry(20, 20);
    const shadowMat = new THREE.ShadowMaterial({
      opacity: 0.15,
      color: new THREE.Color(0x3D3028),
    });
    const shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
    shadowPlane.rotation.x = -Math.PI / 2;
    shadowPlane.position.y = config.groundY || -1.2;
    shadowPlane.receiveShadow = true;
    scene.add(shadowPlane);
  }

  // ... transition, animate, dispose methods
}
```

